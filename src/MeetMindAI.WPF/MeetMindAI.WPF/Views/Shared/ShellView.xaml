<UserControl x:Class="MeetMindAI.WPF.Views.Shared.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->

        <Border Grid.Column="0"
                Background="#111827">

            <StackPanel Margin="20">

                <TextBlock Text="MeetMindAI"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,10,0,40"/>

                <Button Content="Dashboard"
                        Command="{Binding DashboardCommand}"
                        Height="44"
                        Margin="0,0,0,10"/>

                <Button Content="Meetings"
        Command="{Binding MeetingsCommand}"
        Height="44"
       
        Padding="15,0"
        Margin="0,0,0,8"/>

                
                <Button Content="Logout"
        Command="{Binding LogoutCommand}"
        Height="44"
        Margin="0,30,0,0"/>

            </StackPanel>

        </Border>

        <!-- Main content -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <TextBlock Text="Workspace"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="30,0"/>

            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"/>

        </Grid>

    </Grid>

</UserControl>
