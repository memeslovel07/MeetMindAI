<UserControl x:Class="MeetMindAI.WPF.Views.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- Input Style -->
        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#6366F1"/>

                                <Setter TargetName="Border"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- Login Button -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="#4F46E5"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PasswordInputStyle"
       TargetType="PasswordBox">

            <Setter Property="Height"
            Value="46"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="Padding"
            Value="14,0,48,0"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="Background"
            Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
            Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#6366F1"/>

                                <Setter TargetName="Border"
                                Property="BorderThickness"
                                Value="2"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="#F8FAFC">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- LEFT BRAND PANEL -->

        <Grid Grid.Column="0">

            <Grid.Background>

                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="1,1">

                    <GradientStop
                        Color="#111827"
                        Offset="0"/>

                    <GradientStop
                        Color="#312E81"
                        Offset="0.55"/>

                    <GradientStop
                        Color="#4F46E5"
                        Offset="1"/>

                </LinearGradientBrush>

            </Grid.Background>


            <!-- Decorative shapes -->

            <Ellipse Width="360"
                     Height="360"
                     Fill="#12FFFFFF"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-130,-130,0,0"/>

            <Ellipse Width="280"
                     Height="280"
                     Fill="#0FFFFFFF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-90,-90"/>


            <StackPanel
                Width="470"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Logo -->

                <Border Width="58"
                        Height="58"
                        CornerRadius="14"
                        Background="#22FFFFFF"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,28">

                    <TextBlock Text="M"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <TextBlock Text="MeetMindAI"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="White"/>


                <TextBlock
                    Text="Turn conversations into clarity."
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#E0E7FF"
                    Margin="0,16,0,12"/>


                <TextBlock
                    Text="Capture meetings, generate intelligent summaries and turn discussions into actionable work."
                    FontSize="16"
                    Foreground="#C7D2FE"
                    TextWrapping="Wrap"
                    LineHeight="25"
                    Width="440"
                    HorizontalAlignment="Left"/>


                <StackPanel Margin="0,40,0,0">

                    <TextBlock
                        Text="✓  AI-powered meeting summaries"
                        Foreground="#EEF2FF"
                        FontSize="15"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="✓  Intelligent action item extraction"
                        Foreground="#EEF2FF"
                        FontSize="15"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="✓  Organized transcripts and attachments"
                        Foreground="#EEF2FF"
                        FontSize="15"/>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- RIGHT LOGIN PANEL -->

        <Grid Grid.Column="1"
              Background="White">

            <StackPanel
                Width="390"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Welcome back"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#111827"/>

                <TextBlock
                    Text="Sign in to your MeetMindAI workspace"
                    FontSize="14"
                    Foreground="#64748B"
                    Margin="0,8,0,36"/>


                <!-- EMAIL -->

                <TextBlock
                    Text="Email address"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#334155"
                    Margin="0,0,0,8"/>

                <TextBox
                    Style="{StaticResource InputStyle}"
                    Text="{Binding Email,
                           UpdateSourceTrigger=PropertyChanged}"/>


                <!-- PASSWORD -->

                <TextBlock
                         Text="Password"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="#334155"
                         Margin="0,0,0,8"/>

                <Grid Width="388">

                    <!-- Hidden password -->

                    <PasswordBox x:Name="PasswordBox"
                 Height="46"
                 Padding="14,0,48,0"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 Background="#F8FAFC"
                 BorderBrush="#E2E8F0"
                 BorderThickness="1"
                 Style="{StaticResource PasswordInputStyle}"                
                 PasswordChanged="PasswordBox_OnPasswordChanged"/>

                    <!-- Visible password -->

                    <TextBox x:Name="VisiblePasswordBox"
             Height="46"
             Padding="14,0,48,0"
             FontSize="14"
             VerticalContentAlignment="Center"
             Background="#F8FAFC"
             BorderBrush="#E2E8F0"
             BorderThickness="1"
             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
             Visibility="Collapsed"
             Style="{StaticResource InputStyle}"                />

                    <!-- Show / Hide -->

                    <Button x:Name="TogglePasswordButton"
            Content="Show"
            Width="44"
            Height="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,7,0"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#6366F1"
            FontSize="11"
            FontWeight="SemiBold"
            Cursor="Hand"
            Click="TogglePasswordButton_OnClick"/>

                </Grid>


                <!-- ERROR -->

                <Border
                    Background="#FEF2F2"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage,
                        Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="#DC2626"
                        FontSize="13"
                        TextWrapping="Wrap"/>

                </Border>


                <!-- LOGIN -->

                <Button
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}"
                    Margin="0,26,0,0" Click="Button_Click">

                    <Grid>

                        <TextBlock
                            Text="Sign in"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <TextBlock
                            Text="Signing in..."
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="Segoe UI Emoji" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" RenderTransformOrigin="0.592,0.984" Width="94">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleX="4.169"/>
                                    <RotateTransform/>
                                    <TranslateTransform X="-0.023"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                    </Grid>

                </Button>


                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,32,0,0">

                    <TextBlock
                        Text="Powered by "
                        Foreground="#94A3B8"
                        FontSize="12"/>

                    <TextBlock
                        Text="MeetMindAI"
                        Foreground="#6366F1"
                        FontWeight="SemiBold"
                        FontSize="12"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
