<UserControl x:Class="MeetMindAI.WPF.Views.MeetingAttachments.MeetingAttachmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Back -->

                <Button Content="← Back to Meeting"
                        Command="{Binding BackToMeetingCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#4F46E5"
                        Padding="0"
                        Margin="0,0,0,18"/>

                <!-- Header -->

                <Grid Margin="0,0,0,24">

                    

                    <StackPanel>
                        <TextBlock Text="Meeting Attachments"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Upload and manage files related to this meeting."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Height="40"
                                Padding="18,0"
                                Margin="0,0,10,0"/>

                        <Button Command="{Binding UploadCommand}"
                                Height="40"
                                MinWidth="130"
                                Padding="18,0"
                                Background="#4F46E5"
                                Foreground="White"
                                BorderThickness="0">

                            <Grid>

                                <TextBlock Text="+ Upload File"
                                           Visibility="{Binding IsUploading,
                                               Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <TextBlock Text="Uploading..."
                                           Visibility="{Binding IsUploading,
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </Grid>

                <!-- Upload progress -->

                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Margin="0,0,0,18"
                             Visibility="{Binding IsUploading,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>

                </Border>

                <!-- Success -->

                <Border Background="#F0FDF4"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#166534"
                               TextWrapping="Wrap"/>

                </Border>

                <!-- Statistics -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,22">

                    <StackPanel>

                        <TextBlock Text="Files"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding AttachmentCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Empty State -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="42"
                        Visibility="{Binding HasAttachments,
                            Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="460">

                        <Border Width="60"
                                Height="60"
                                CornerRadius="30"
                                Background="#EEF2FF">

                            <TextBlock Text="＋"
                                       FontSize="25"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="No attachments yet"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>

                        <TextBlock Text="Upload documents, images, audio, or other files related to this meeting."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <Button Content="+ Upload File"
                                Command="{Binding UploadCommand}"
                                Height="40"
                                Padding="20,0"
                                Margin="0,22,0,0"
                                Background="#4F46E5"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>

                </Border>

                <!-- Files -->

                <ItemsControl ItemsSource="{Binding Attachments}"
                              Visibility="{Binding HasAttachments,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File icon -->

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="10"
                                            Background="#EEF2FF"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="📄"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- File information -->

                                    <StackPanel Grid.Column="1"
                                                Margin="15,0,20,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding OriginalFileName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,6,0,0">

                                            <TextBlock Text="{Binding AttachmentType}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>

                                            <TextBlock Text="  •  "
                                                       Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding DisplaySize}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>

                                            <TextBlock Text="  •  "
                                                       Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding CreatedAtLocal,
                                                StringFormat={}{0:g}}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>

                                        </StackPanel>

                                    </StackPanel>

                                    <!-- Actions -->

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Button Content="Open"
                                                Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                MinWidth="70"
                                                Padding="14,0"
                                                Margin="0,0,8,0"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                Foreground="#334155"/>

                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                MinWidth="70"
                                                Padding="14,0"
                                                Background="#FEF2F2"
                                                BorderBrush="#FECACA"
                                                Foreground="#B91C1C"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- Initial Loading Screen -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading attachments..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Getting files for this meeting"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
