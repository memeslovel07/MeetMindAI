<UserControl x:Class="MeetMindAI.WPF.Views.Meetings.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Header -->

                <Grid Margin="0,0,0,28">

                    <StackPanel>

                        <TextBlock Text="Meetings"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Manage and review your meetings."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Height="40"
                                Padding="18,0"
                                Margin="0,0,10,0"/>

                        <Button Content="+ New Meeting"
        Height="40"
        Padding="18,0"
        Background="#4F46E5"
        Foreground="White"
        BorderThickness="0"
        Click="NewMeeting_OnClick"/>

                    </StackPanel>

                </Grid>


                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,20"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Meeting Table -->

                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <StackPanel>

                        <!-- Table Header -->

                        <Grid Background="#F8FAFC"
                              Margin="1"
                              Height="48">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Meeting"
                                       Margin="20,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>

                            <TextBlock Grid.Column="1"
                                       Text="Scheduled"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>

                            <TextBlock Grid.Column="2"
                                       Text="Duration"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>

                            <TextBlock Grid.Column="3"
                                       Text="Status"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>

                            <TextBlock Grid.Column="4"
                                       Text="Actions"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"/>

                        </Grid>


                        <!-- Rows -->

                        <ItemsControl ItemsSource="{Binding Meetings}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="#E2E8F0"
                                            BorderThickness="0,1,0,0">

                                        <Grid MinHeight="64">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Title -->

                                            <TextBlock Text="{Binding Title}"
                                                       Margin="20,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"
                                                       TextTrimming="CharacterEllipsis"/>


                                            <!-- Date -->

                                            <TextBlock Grid.Column="1"
           Text="{Binding ScheduledAtLocal}"
           VerticalAlignment="Center"
           Foreground="#64748B"/>


                                            <!-- Duration -->
                                            <TextBlock Grid.Column="2"
           Text="{Binding DurationMinutes}"
           VerticalAlignment="Center"
           Foreground="#64748B"/>


                                            <!-- Status -->

                                            <Border Grid.Column="3"
                                                    Background="#EEF2FF"
                                                    CornerRadius="12"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="#4338CA"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>

                                            </Border>


                                            <!-- Actions -->

                                            <Button Grid.Column="4"
        Content="Open"
        Command="{Binding DataContext.OpenMeetingCommand,
                  RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}"
        Padding="12,6"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <!-- Empty State -->

                        <StackPanel Margin="20,55"
                                    Visibility="{Binding Meetings.Count,
                                        Converter={StaticResource ZeroToVisibilityConverter}}">

                            <TextBlock Text="No meetings yet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Create your first meeting to get started."
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading your meetings..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Fetching your meeting workspace"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
