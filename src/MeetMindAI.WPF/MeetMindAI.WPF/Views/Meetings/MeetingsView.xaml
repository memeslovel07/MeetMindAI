<UserControl x:Class="MeetMindAI.WPF.Views.Meetings.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Header -->

                <Grid Margin="0,0,0,28">

                    <StackPanel>

                        <TextBlock Text="Meetings"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Manage and review your meetings."
           Margin="0,8,0,0"/>

                        <TextBox
    MaxWidth="350"
HorizontalAlignment="Left"
    Height="38"
    Margin="0,16,0,0"
    Text="{Binding SearchText,
                   UpdateSourceTrigger=PropertyChanged}"
    VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Height="40"
                                Padding="18,0"
                                Margin="0,0,10,0"/>

                        <Button Content="+ New Meeting"
        Height="40"
        Padding="18,0"
        Background="#4F46E5"
        Foreground="White"
        BorderThickness="0"
        Click="NewMeeting_OnClick"/>

                    </StackPanel>

                </Grid>


                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,20"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Meeting Table -->


                    <StackPanel>

                        <!-- Table Header -->

                       


                        <!-- Rows -->

                      <ItemsControl   ItemsSource="{Binding FilteredMeetings}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Margin="0,0,0,12"
            Padding="18"
            CornerRadius="10"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock
                    Text="{Binding Title}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="#111827"/>

                                                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,12,0,0">

                                                    <TextBlock
                        Text="📅"
                        FontSize="14"/>

                                                    <TextBlock
                        Text="{Binding ScheduledAtLocal}"
                        Margin="6,0,18,0"
                        Foreground="#6B7280"/>

                                                    <TextBlock
                        Text="⏱"
                        FontSize="14"/>

                                                    <TextBlock
                        Text="{Binding DurationMinutes}"
                        Margin="6,0,0,0"
                        Foreground="#6B7280"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right">

                                                <Border
                    Background="#EEF2FF"
                    CornerRadius="14"
                    Padding="12,4"
                    HorizontalAlignment="Right">

                                                    <TextBlock
                        Text="{Binding Status}"
                        Foreground="#4338CA"
                        FontWeight="SemiBold"/>

                                                </Border>

                                                <Button
                    Margin="0,18,0,0"
                    Width="90"
                    Height="34"
                    Content="Open"
                    Command="{Binding DataContext.OpenMeetingCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <!-- Empty State -->

                        <StackPanel Margin="20,55"
                                    Visibility="{Binding Meetings.Count,
                                        Converter={StaticResource ZeroToVisibilityConverter}}">

                            <TextBlock Text="No meetings yet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Create your first meeting to get started."
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </StackPanel>

               

            </StackPanel>

        </ScrollViewer>


        <!-- Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading your meetings..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Fetching your meeting workspace"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
