<UserControl x:Class="MeetMindAI.WPF.Views.Meetings.MeetingDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <Button Content="← Back to Meetings"
        Command="{Binding BackToMeetingsCommand}"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Foreground="#4F46E5"
        Padding="0"
        Margin="0,0,0,18"/>

                <Border Background="#FEF2F2"
        CornerRadius="8"
        Padding="14"
        Margin="0,0,0,18"
        Visibility="{Binding ErrorMessage,
            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
               Foreground="#B91C1C"
               TextWrapping="Wrap"/>

                </Border>

                <!-- Header -->

                <Grid Margin="0,0,0,28">

                    

                    <StackPanel>

                        <TextBlock Text="Meeting Details"
                                   FontSize="14"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding Meeting.Title}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding Meeting.Description}"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- Meeting Information -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,0,0,22">

                    <StackPanel>

                        <TextBlock Text="Meeting Information"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,20"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Schedule -->

                            <StackPanel>

                                <TextBlock Text="Scheduled"
                                           FontSize="12"
                                           Foreground="#94A3B8"/>

                                <TextBlock Text="{Binding Meeting.ScheduledAtLocal}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,6,0,0"/>

                            </StackPanel>


                            <!-- Duration -->

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Duration"
                                           FontSize="12"
                                           Foreground="#94A3B8"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,0">

                                    <TextBlock Text="{Binding Meeting.DurationMinutes}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>

                                    <TextBlock Text=" minutes"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>

                                </StackPanel>

                            </StackPanel>


                            <!-- Status -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Status"
                                           FontSize="12"
                                           Foreground="#94A3B8"/>

                                <Border Background="#EEF2FF"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0">

                                    <TextBlock Text="{Binding Meeting.Status}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#4338CA"/>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- Workspace -->

                <TextBlock Text="Meeting Workspace"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,14"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transcript -->

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Transcript"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="View and manage the meeting transcript."
                                       Foreground="#64748B"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,16"/>

                            <Button Content="Open Transcript"
        Command="{Binding OpenTranscriptCommand}"
        Height="36"
        HorizontalAlignment="Left"
        Padding="15,0"/>

                        </StackPanel>

                    </Border>


                    <!-- AI Summary -->

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="AI Summary"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Generate and review an AI meeting summary."
                                       Foreground="#64748B"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,16"/>

                            <Button Content="View Summary"
                                    Command="{Binding OpenSummaryCommand}"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Padding="15,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- Second Row -->

                <Grid Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Action Items -->

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Action Items"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Track AI-extracted and manually created tasks."
           Foreground="#64748B"
           FontSize="13"
           TextWrapping="Wrap"
           Margin="0,8,0,16"/>

                            <Button Content="View Action Items"
                                    Command="{Binding OpenActionItemsCommand}"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Padding="15,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Attachments -->

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Attachments"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Upload, open, and manage meeting files."
           Foreground="#64748B"
           FontSize="13"
           TextWrapping="Wrap"
           Margin="0,8,0,16"/>

                            <Button Content="View Attachments"
                                    Command="{Binding OpenAttachmentsCommand}"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Padding="15,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>


        <!-- Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading meeting..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Preparing your meeting workspace"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
