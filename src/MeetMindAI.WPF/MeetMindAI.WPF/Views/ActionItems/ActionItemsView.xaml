<UserControl x:Class="MeetMindAI.WPF.Views.ActionItems.ActionItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Back -->

                <Button Content="← Back to Meeting"
                        Command="{Binding BackToMeetingCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#4F46E5"
                        Padding="0"
                        Margin="0,0,0,18"/>

                <!-- Header -->

                <Grid Margin="0,0,0,24">

                    <StackPanel>
                        <TextBlock Text="Action Items"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Track tasks and extract actionable work from the meeting transcript."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Height="40"
                                Padding="18,0"
                                Margin="0,0,10,0"/>

                        <Button Content="+ New Action Item"
        Command="{Binding CreateCommand}"
        Height="40"
        Padding="18,0"
        Margin="0,0,10,0"
        Background="White"
        Foreground="#4F46E5"
        BorderBrush="#C7D2FE"/>

                        <Button Command="{Binding ExtractCommand}"
                                Height="40"
                                MinWidth="150"
                                Padding="18,0"
                                Background="#4F46E5"
                                Foreground="White"
                                BorderThickness="0">

                            

                            <Grid>
                                <TextBlock Text="Extract with AI"
                                           Visibility="{Binding IsExtracting,
                                               Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <TextBlock Text="Extracting..."
                                           Visibility="{Binding IsExtracting,
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                        </Button>

                    </StackPanel>

                </Grid>

                <!-- AI Progress -->

                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Margin="0,0,0,16"
                             Visibility="{Binding IsExtracting,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Success -->

                <Border Background="#F0FDF4"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#166534"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Statistics -->

                <Grid Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Total"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock Text="{Binding TotalActionItems}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Pending"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock Text="{Binding PendingActionItems}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="Completed"
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock Text="{Binding CompletedActionItems}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Empty State -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40"
                        Visibility="{Binding HasActionItems,
                            Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="480">

                        <Border Width="58"
                                Height="58"
                                CornerRadius="29"
                                Background="#EEF2FF">

                            <TextBlock Text="✓"
                                       FontSize="22"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="No action items yet"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>

                        <TextBlock Text="Use AI extraction to identify actionable tasks from this meeting's transcript."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <Button Command="{Binding ExtractCommand}"
                                Content="Extract with AI"
                                Height="40"
                                Padding="20,0"
                                Margin="0,22,0,0"
                                Background="#4F46E5"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>
                </Border>

                <!-- Action Item Cards -->

                <ItemsControl ItemsSource="{Binding ActionItems}"
                              Visibility="{Binding HasActionItems,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Details -->

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,14,0,0">

                                            <!-- Priority -->

                                            <Border Background="#FFF7ED"
                                                    CornerRadius="10"
                                                    Padding="9,4"
                                                    Margin="0,0,8,0">

                                                <TextBlock Text="{Binding Priority}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C2410C"/>
                                            </Border>

                                            <!-- Status -->

                                            <Border Background="#EEF2FF"
                                                    CornerRadius="10"
                                                    Padding="9,4"
                                                    Margin="0,0,8,0">

                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4338CA"/>
                                            </Border>

                                            <TextBlock Text="Due: "
                                                       FontSize="12"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>

                                            <TextBlock Text="{Binding DueDateLocal,
                                                StringFormat={}{0:g}}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </StackPanel>

                                    <!-- Actions -->

                                    <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="20,0,0,0">

                                        <!-- Edit -->

                                        <Button Command="{Binding DataContext.EditCommand,
                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Height="34"
            MinWidth="64"
            Padding="14,0"
            Margin="0,0,8,0"
            Background="#F8FAFC"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            Foreground="#334155">

                                            <TextBlock Text="Edit"/>

                                        </Button>

                                        <!-- Complete -->

                                        <Button Command="{Binding DataContext.CompleteCommand,
                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Height="34"
            MinWidth="84"
            Padding="14,0"
            Margin="0,0,8,0"
            Background="#F0FDF4"
            BorderBrush="#BBF7D0"
            BorderThickness="1"
            Foreground="#166534">

                                            <TextBlock Text="Complete"/>

                                        </Button>

                                        <!-- Delete -->

                                        <Button Command="{Binding DataContext.DeleteCommand,
                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Height="34"
            MinWidth="70"
            Padding="14,0"
            Background="#FEF2F2"
            BorderBrush="#FECACA"
            BorderThickness="1"
            Foreground="#B91C1C">

                                            <TextBlock Text="Delete"/>

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading action items..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Preparing tasks for this meeting"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
