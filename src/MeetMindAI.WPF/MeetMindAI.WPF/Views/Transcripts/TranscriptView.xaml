<UserControl x:Class="MeetMindAI.WPF.Views.Transcripts.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Header -->

                <Button Content="← Back to Meeting"
        Command="{Binding BackToMeetingCommand}"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Foreground="#4F46E5"
        Padding="0"
        Margin="0,0,0,18"/>

                <TextBlock Text="Transcript"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Review or edit the transcript for this meeting."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,8,0,28"/>


                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Success -->

                <Border Background="#F0FDF4"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#166534"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Transcript Form -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">

                    <StackPanel>

                        <!-- Metadata -->

                        <Grid Margin="0,0,0,22">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Language -->

                            <StackPanel>

                                <TextBlock Text="Language"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,0,0,7"/>

                                <TextBox Text="{Binding Language,
                                               UpdateSourceTrigger=PropertyChanged}"
                                         Height="42"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- Duration -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Duration (seconds)"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,0,0,7"/>

                                <TextBox Text="{Binding DurationSeconds,
                                               UpdateSourceTrigger=PropertyChanged}"
                                         Height="42"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>

                        </Grid>


                        <!-- Content -->

                        <TextBlock Text="Transcript content"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,7"/>

                        <TextBox Text="{Binding Content,
                                       UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="320"
                                 Padding="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="True"/>


                        <!-- Footer -->

                        <Grid Margin="0,22,0,0">

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#94A3B8"
                                       FontSize="12">

                                <Run Text="Changes are saved to the meeting transcript."/>

                            </TextBlock>


                            <Button Command="{Binding SaveCommand}"
                                    HorizontalAlignment="Right"
                                    Height="42"
                                    MinWidth="150"
                                    Padding="20,0"
                                    Background="#4F46E5"
                                    Foreground="White"
                                    BorderThickness="0">

                                <Grid>

                                    <TextBlock Text="Save Transcript"
                                               Visibility="{Binding IsSaving,
                                                   Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                    <TextBlock Text="Saving..."
                                               Visibility="{Binding IsSaving,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                </Grid>

                            </Button>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- Initial Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading transcript..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Checking this meeting's transcript"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
