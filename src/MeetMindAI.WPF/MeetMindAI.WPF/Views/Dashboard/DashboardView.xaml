<UserControl x:Class="MeetMindAI.WPF.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="32">

            <!-- Header -->

            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Overview of your meetings and recent activity."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,8,0,30"/>


            <!-- Stats -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total -->

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Total Meetings"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock Text="{Binding TotalMeetings}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- Scheduled -->

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Scheduled"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock Text="{Binding ScheduledMeetings}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- Completed -->

                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="12"
                        Padding="24"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Completed"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock Text="{Binding CompletedMeetings}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#059669"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <Grid>

                <!-- Normal Dashboard -->

                <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        Visibility="{Binding IsLoading,
            Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <!-- Your existing Dashboard StackPanel goes here -->

                </ScrollViewer>


                <!-- Loading Overlay -->

                <Grid Background="#F8FAFC"
          Visibility="{Binding IsLoading,
              Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                        <ProgressBar Width="220"
                         Height="5"
                         IsIndeterminate="True"/>

                        <TextBlock Text="Loading your dashboard..."
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>

                        <TextBlock Text="Fetching your latest meetings"
                       FontSize="13"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

                    </StackPanel>

                </Grid>

            </Grid>


            <!-- Recent Meetings -->

            <Border Background="White"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Margin="0,28,0,0"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Recent Meetings"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,18"/>

                    <ItemsControl ItemsSource="{Binding RecentMeetings}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScheduledAtUtc,
                                                       StringFormat={}{0:dd MMM yyyy}}"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DurationMinutes,
                                                       StringFormat={}{0} min}"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="3"
                                                Background="#EEF2FF"
                                                CornerRadius="12"
                                                Padding="10,5"
                                                HorizontalAlignment="Left">

                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="#4338CA"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>




                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Border Background="#FEF2F2"
        CornerRadius="8"
        Padding="14"
        Margin="0,15,0,0"
        Visibility="{Binding ErrorMessage,
            Converter={StaticResource StringToVisibilityConverter}}">

                        <TextBlock Text="{Binding ErrorMessage}"
               Foreground="#B91C1C"
               TextWrapping="Wrap"/>

                    </Border>

                    <!-- Empty state -->

                    <TextBlock Text="No meetings yet."
                               HorizontalAlignment="Center"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,25"
                               Visibility="{Binding RecentMeetings.Count,
                                   Converter={StaticResource ZeroToVisibilityConverter}}"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
