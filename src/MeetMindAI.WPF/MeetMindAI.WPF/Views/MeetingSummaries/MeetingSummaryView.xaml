<UserControl x:Class="MeetMindAI.WPF.Views.MeetingSummaries.MeetingSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">

        <!-- Main Content -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading,
                          Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel Margin="32">

                <!-- Back -->

                <Button Content="← Back to Meeting"
                        Command="{Binding BackToMeetingCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#4F46E5"
                        Padding="0"
                        Margin="0,0,0,18"/>

                <!-- Header -->

                <Grid Margin="0,0,0,26">

                    <StackPanel>

                        <TextBlock Text="AI Summary"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Generate a concise summary from the meeting transcript."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- Error -->

                <Border Background="#FEF2F2"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Success -->

                <Border Background="#F0FDF4"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">

                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#166534"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- No Summary Yet -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40"
                        Visibility="{Binding SummaryExists,
                            Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="500">

                        <Border Width="58"
                                Height="58"
                                CornerRadius="29"
                                Background="#EEF2FF">

                            <TextBlock Text="AI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="No AI summary yet"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>

                        <TextBlock Text="MeetMindAI can analyze this meeting's transcript and generate a concise summary."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,9,0,0"/>

                        <Button Command="{Binding GenerateCommand}"
                                Height="42"
                                MinWidth="170"
                                Padding="20,0"
                                Background="#4F46E5"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,24,0,0">

                            <Grid>

                                <TextBlock Text="Generate Summary"
                                           Visibility="{Binding IsGenerating,
                                               Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <TextBlock Text="Generating..."
                                           Visibility="{Binding IsGenerating,
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            </Grid>

                        </Button>

                        <ProgressBar Width="170"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Margin="0,12,0,0"
                                     Visibility="{Binding IsGenerating,
                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    </StackPanel>

                </Border>


                <!-- Existing Summary -->

                <StackPanel Visibility="{Binding SummaryExists,
                            Converter={StaticResource BooleanToVisibilityConverter}}">

                    <!-- Summary -->

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="26">

                        <StackPanel>

                            <Grid Margin="0,0,0,20">

                                <StackPanel>

                                    <TextBlock Text="Meeting Summary"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#1E293B"/>

                                    <TextBlock Text="AI-generated from the meeting transcript"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <Button Command="{Binding RegenerateCommand}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Height="38"
                                        MinWidth="120"
                                        Padding="16,0">

                                    <Grid>

                                        <TextBlock Text="Regenerate"
                                                   Visibility="{Binding IsGenerating,
                                                       Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <TextBlock Text="Generating..."
                                                   Visibility="{Binding IsGenerating,
                                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    </Grid>

                                </Button>

                            </Grid>


                            <Separator Background="#E2E8F0"
                                       Margin="0,0,0,20"/>


                            <TextBlock Text="{Binding Summary.Summary}"
                                       FontSize="15"
                                       LineHeight="24"
                                       Foreground="#334155"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- AI Metadata -->

                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,18,0,0">

                        <StackPanel>

                            <TextBlock Text="Generation Details"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,18"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- Provider -->

                                <StackPanel>

                                    <TextBlock Text="Provider"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>

                                    <TextBlock Text="{Binding Summary.Provider}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <!-- Model -->

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="Model"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>

                                    <TextBlock Text="{Binding Summary.Model}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <!-- Prompt -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="Prompt Version"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>

                                    <TextBlock Text="{Binding Summary.PromptVersion}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <!-- Generated -->

                                <StackPanel Grid.Column="3">

                                    <TextBlock Text="Generated"
                                               FontSize="11"
                                               Foreground="#94A3B8"/>

                                    <TextBlock Text="{Binding Summary.GeneratedAtLocal}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Grid>


                            <!-- Regenerated indicator -->

                            <Border Background="#EEF2FF"
                                    CornerRadius="10"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Margin="0,18,0,0"
                                    Visibility="{Binding Summary.IsRegenerated,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                <TextBlock Text="Regenerated"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#4338CA"/>

                            </Border>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- Initial Loading -->

        <Grid Background="#F8FAFC"
              Visibility="{Binding IsLoading,
                  Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <ProgressBar Width="220"
                             Height="5"
                             IsIndeterminate="True"/>

                <TextBlock Text="Loading AI summary..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Checking for an existing meeting summary"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
